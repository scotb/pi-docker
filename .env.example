# .env.example — copy to .env and fill in. .env is git-ignored: keep
# personal data (identity, secrets) out of the repo.
#
# build.sh reads these as base values; variables already set in your
# shell environment win over .env values.

# --- Baked repo pins (full SHAs) -----------------------------------------
# Empty value = resolve the head of the tracked branch at build time.

# pi (earendil-works/pi, branch main)
PI_HASH=
# Fork override (default: https://github.com/earendil-works/pi)
#PI_URL=

# pi-subagents fork (scotb/pi-subagents, branch self-compact)
PI_SUBAGENTS_HASH=
#PI_SUBAGENTS_URL=

# self-compact extension (scotb/self-compact-pi-agent, branch deploy)
SELF_COMPACT_HASH=
#SELF_COMPACT_URL=

# matt skills (mattpocock/skills, branch main)
MATT_SKILLS_HASH=
#MATT_SKILLS_URL=

# --- Build-time git identity (recorded in baked-repo commits) ------------
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- lean-ctx pinned binary -----------------------------------------------
LEAN_CTX_BIN_VERSION=
LEAN_CTX_BIN_SHA256=

# Image tags are not env-driven: pass --tag to build.sh
# (pi-sandbox:latest is always tagged).
